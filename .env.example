# Copy to .env and fill in. NEVER commit .env (gitignored).
# AWS credentials come from the environment / ~/.aws — never put secrets here.

TICKSTREAM_AWS_REGION=us-east-1
TICKSTREAM_S3_BUCKET=tickstream-lake-<aws-account-id>
TICKSTREAM_GLUE_DATABASE=tickstream
TICKSTREAM_KAFKA_BOOTSTRAP=localhost:9092
TICKSTREAM_TOPIC=trades.raw
TICKSTREAM_SYMBOLS=["XRPUSDT"]
TICKSTREAM_BINANCE_WS_URL=wss://data-stream.binance.vision
TICKSTREAM_BATCH_INTERVAL_S=45
TICKSTREAM_BATCH_MAX_ROWS=20000
TICKSTREAM_FRESHNESS_MAX_LAG_S=300
TICKSTREAM_QUALITY_INTERVAL_S=600
TICKSTREAM_LOG_LEVEL=INFO

# Used only by `make infra-plan` / `make infra-apply` (TF_VAR_ convention).
# Provide the real address at apply time; the default is a placeholder.
TF_VAR_alert_email=budget-alerts@example.com
