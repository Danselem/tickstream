# Copy to .env and fill in. NEVER commit .env (gitignored).
# AWS credentials use the standard SDK names so boto3/PyIceberg/dbt pick them up
# both on the host and inside compose services (via env_file).

AWS_ACCESS_KEY_ID=<pipeline-user-key-id>
AWS_SECRET_ACCESS_KEY=<pipeline-user-secret>
AWS_REGION=us-east-1

TICKSTREAM_AWS_REGION=us-east-1
TICKSTREAM_S3_BUCKET=tickstream-lake-<aws-account-id>
TICKSTREAM_GLUE_DATABASE=tickstream
TICKSTREAM_KAFKA_BOOTSTRAP=localhost:9092
TICKSTREAM_TOPIC=trades.raw
# TICKSTREAM_TICKER_TOPIC=ticker.raw
# TICKSTREAM_TICKER_CONSUMER_GROUP=ticker-writer
TICKSTREAM_SYMBOLS='["BTCUSDT","ETHUSDT","SOLUSDT","ADAUSDT","DOGEUSDT","LINKUSDT","AVAXUSDT"]'
# Optional explicit partition per symbol (JSON); unmapped symbols hash by key.
# Spread hot symbols so one partition does not own most of the traffic (ADR-028).
# TICKSTREAM_SYMBOL_PARTITIONS='{"BTCUSDT":1,"ETHUSDT":2,"DOGEUSDT":2,"LINKUSDT":2}'
TICKSTREAM_BINANCE_WS_URL=wss://data-stream.binance.vision
# Websocket keepalive (s): generous ping_timeout avoids spurious 1011 reconnects.
TICKSTREAM_WS_PING_INTERVAL_S=20
TICKSTREAM_WS_PING_TIMEOUT_S=60
# Reconnect if the stream goes silent (messages/s) while the socket stays open.
TICKSTREAM_WS_STALE_AFTER_S=60
TICKSTREAM_BATCH_INTERVAL_S=45
TICKSTREAM_BATCH_MAX_ROWS=20000
TICKSTREAM_FRESHNESS_MAX_LAG_S=300
TICKSTREAM_QUALITY_INTERVAL_S=600
TICKSTREAM_MAINTENANCE_EVERY_N_RUNS=72
# TICKSTREAM_CATALOG_TYPE=glue  # set to "sql" only for offline pytest
TICKSTREAM_LOG_LEVEL=INFO

# PyIceberg S3 timeouts (s): generous because short timeouts turn transient
# network degradation into crash loops (Oct 2026 incident).
TICKSTREAM_S3_CONNECT_TIMEOUT_S=15
TICKSTREAM_S3_REQUEST_TIMEOUT_S=60

# Used only by `make infra-plan` / `make infra-apply` (TF_VAR_ convention).
# Provide the real address at apply time; the default is a placeholder.
TF_VAR_alert_email=budget-alerts@example.com

# Superset (compose service + dashboard provisioning). Generate the secret with:
#   openssl rand -hex 32
SUPERSET_SECRET_KEY=<openssl-rand-hex-32>
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=<choose-a-strong-password>
SUPERSET_ADMIN_EMAIL=admin@example.com
